# 설정 양식: 이 파일에는 실제 인증키를 넣지 않는다.
# .env로 복사한 뒤 각 서비스의 일반 인증키(Decoding)를 입력한다.
# 검증 도구는 .env를 읽으며 이 예시 파일은 실행에 사용하지 않는다.
# 같은 PC의 새 작업 폴더는 사용자 홈 .nadeulirang/.env의 공통 설정을 사용한다.
# 폴더별 비어 있지 않은 값이 우선하며 공통 보관은 scripts/save-local-settings.ps1을 실행한다.

# 1. 한국관광공사_국문 관광정보 서비스_GW (TourAPI)
# 용도: 관광지·행사·문화시설의 목록과 상세 정보를 조회하는 TourAPI 인증키(Decoding).
TOURAPI_SERVICE_KEY=

# 2. 전국문화축제표준데이터
# 용도: 축제 일정·장소·주소를 보완하는 전국문화축제표준데이터 인증키(Decoding).
FESTIVAL_SERVICE_KEY=

# 3. 전국박물관미술관정보표준데이터
# 용도: 박물관·미술관의 운영시간·휴관일·요금을 보완하는 전국박물관미술관정보표준데이터 인증키(Decoding).
MUSEUM_SERVICE_KEY=

# 4. 로컬 백엔드 DB 접속 (use-local-env.ps1이 현재 세션에 전달)
# 예: jdbc:postgresql://127.0.0.1:5432/nadeulirang
# 용도: 백엔드가 접속할 PostgreSQL의 JDBC 주소.
DB_URL=
# 용도: 백엔드가 PostgreSQL에 접속할 때 사용하는 DB 계정 이름.
DB_USERNAME=
# 용도: DB_USERNAME 계정의 PostgreSQL 접속 비밀번호.
DB_PASSWORD=

# 5. 회원 인증: 작업 폴더 .env에서 현재 실행 세션에만 적용한다.
# 정책 버전은 실제 서비스 정책 확인 후 설정한다. 인증키나 제공자의 약관 버전이 아니다.
# 용도: 최초 가입 시 동의한 나들이랑 이용약관의 버전을 기록한다. 미설정이면 신규 가입을 차단한다.
AUTH_TERMS_VERSION=
# 용도: 최초 가입 시 동의한 나들이랑 개인정보 고지의 버전을 기록한다. 미설정이면 신규 가입을 차단한다.
AUTH_PRIVACY_VERSION=
# 용도: 카카오 로그인 앱의 REST API 키. 인증 요청에서 앱을 식별한다.
KAKAO_CLIENT_ID=
# 용도: 카카오 로그인 인증 코드를 토큰으로 교환할 때 서버에서 사용하는 Client Secret.
KAKAO_CLIENT_SECRET=
# 용도: 네이버 로그인 앱의 Client ID. 인증 요청에서 앱을 식별한다.
NAVER_CLIENT_ID=
# 용도: 네이버 로그인 인증 코드를 토큰으로 교환할 때 서버에서 사용하는 Client Secret.
NAVER_CLIENT_SECRET=
# 용도: 구글 웹 OAuth 클라이언트 ID. 로그인 앱 식별과 ID 토큰 대상 검증에 사용한다.
GOOGLE_CLIENT_ID=
# 용도: 구글 로그인 인증 코드를 토큰으로 교환할 때 서버에서 사용하는 클라이언트 보안 비밀번호.
GOOGLE_CLIENT_SECRET=
