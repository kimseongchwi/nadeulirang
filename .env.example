# 설정 양식: 이 파일에는 실제 인증키를 넣지 않는다.
# .env로 복사한 뒤 각 서비스의 일반 인증키(Decoding)를 입력한다.
# 검증 도구는 .env를 읽으며 이 예시 파일은 실행에 사용하지 않는다.

# 1. 한국관광공사_국문 관광정보 서비스_GW (TourAPI)
# 용도: 관광지·행사·문화시설의 목록 및 상세 정보 검증
TOURAPI_SERVICE_KEY=

# 2. 전국문화축제표준데이터
# 용도: 축제 일정·장소·주소 등 보완 정보 검증
FESTIVAL_SERVICE_KEY=

# 3. 전국박물관미술관정보표준데이터
# 용도: 박물관·미술관의 운영시간·휴관일·관람료 등 보완 정보 검증
MUSEUM_SERVICE_KEY=

# 4. 로컬 백엔드 DB 접속 (use-local-env.ps1이 현재 세션에 전달)
# 예: jdbc:postgresql://127.0.0.1:5432/nadeulirang
DB_URL=
DB_USERNAME=
DB_PASSWORD=
